# USDT to INR Desk — Production config
# Copy to .env and fill in
DATABASE_URL=postgres://postgres:password@localhost:5432/desk
JWT_SECRET=change-me-to-a-long-random-string

# Exchange rate
BASE_RATE_INR=88.00
SPREAD_PERCENT=1.5

# Server
PORT=3000

# SMS OTP (Twilio) — leave blank for dev mode (OTPs logged to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram merchant bot
TELEGRAM_BOT_TOKEN=

# Blockchain wallets — leave blank to auto-generate on first start
WALLET_ENCRYPTION_KEY=change-me-to-a-32-character-key

# Blockchain APIs (at least one needed for deposit scanning)
# Tatum.io — supports BSC + Tron, free tier available
TATUM_API_KEY=
# BSCScan — free API for BSC only
BSCSCAN_API_KEY=
# TronGrid — free API for Tron only
TRONGRID_API_KEY=

# USDT contract addresses (defaults are correct for mainnet)
# BEP20_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# TRC20_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Seed accounts (created on first deploy if not present)
SEED_USER_EMAIL=user@desk.test
SEED_USER_PASSWORD=testuser123
SEED_ADMIN_EMAIL=admin@desk.test
SEED_ADMIN_PASSWORD=testadmin123

# Public URL (for file uploads, callbacks)
APP_URL=https://your-app.onrender.com