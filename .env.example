# TEST BUILD - NO REAL MONEY. Copy to .env and edit.
DATABASE_URL=postgres://postgres:password@localhost:5432/desk
JWT_SECRET=change-me-long-random-string
# Paste the token from @BotFather here. Leave as-is to run without Telegram.
TELEGRAM_BOT_TOKEN=your-token-from-BotFather
BASE_RATE_INR=88.00
SPREAD_PERCENT=1.5
PORT=3000
# 0.0.0.0 lets phones on the same Wi-Fi open the app. Use 127.0.0.1 for this computer only.
HOST=0.0.0.0

# Test accounts created by `npm run seed` (fake, local only)
SEED_USER_EMAIL=user@desk.test
SEED_USER_PASSWORD=testuser123
SEED_ADMIN_EMAIL=admin@desk.test
SEED_ADMIN_PASSWORD=testadmin123
